    <AssemblyName>resglbprobe</AssemblyName>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == ''">$(LOCALAPPDATA)\Temp\opencode\ar-ref\Source\0Bins\AssetRipper.GUI.Free\Release</ReferenceRoot>
