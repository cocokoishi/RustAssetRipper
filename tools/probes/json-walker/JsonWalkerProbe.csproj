<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>jsonwalkprobe</AssemblyName>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AssetRipper.Export.PrimaryContent">
      <HintPath>$(ReferenceRoot)\AssetRipper.Export.PrimaryContent.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.Assets">
      <HintPath>$(ReferenceRoot)\AssetRipper.Assets.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
