<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AssetDepsProbe</AssemblyName>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == ''">$(LOCALAPPDATA)\Temp\opencode\ar-ref</ReferenceRoot>
    <RefBin>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release</RefBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AssetRipper.Assets">
      <HintPath>$(RefBin)\AssetRipper.Assets.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.Import">
      <HintPath>$(RefBin)\AssetRipper.Import.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.IO.Files">
      <HintPath>$(RefBin)\AssetRipper.IO.Files.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.IO.Endian">
      <HintPath>$(RefBin)\AssetRipper.IO.Endian.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.Primitives">
      <HintPath>$(RefBin)\AssetRipper.Primitives.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.Numerics">
      <HintPath>$(RefBin)\AssetRipper.Numerics.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(RefBin)\*.dll" CopyToOutputDirectory="PreserveNewest" LinkBase="ref" />
  </ItemGroup>
</Project>
