<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LangNamesProbe</AssemblyName>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == ''">$(LOCALAPPDATA)\Temp\opencode\ar-ref</ReferenceRoot>
    <RefBin>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release</RefBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AssetRipper.GUI.Localizations">
      <HintPath>$(RefBin)\AssetRipper.GUI.Localizations.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(RefBin)\AssetRipper.GUI.Localizations.dll" CopyToOutputDirectory="PreserveNewest" LinkBase="ref" />
  </ItemGroup>
</Project>
