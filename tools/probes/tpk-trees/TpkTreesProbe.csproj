<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TpkTreeProbe</AssemblyName>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == ''">$(LOCALAPPDATA)\Temp\opencode\ar-ref</ReferenceRoot>
    <RefBin>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release</RefBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AssetRipper.Tpk">
      <HintPath>$(RefBin)\AssetRipper.Tpk.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.SourceGenerated">
      <HintPath>$(RefBin)\AssetRipper.SourceGenerated.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.Primitives">
      <HintPath>$(RefBin)\AssetRipper.Primitives.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(RefBin)\*.dll" CopyToOutputDirectory="PreserveNewest" LinkBase="ref" />
  </ItemGroup>
</Project>
