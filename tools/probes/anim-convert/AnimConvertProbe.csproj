<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AnimConvertProbe</AssemblyName>
    <RestorePackagesPath>packages</RestorePackagesPath>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == ''">$(LOCALAPPDATA)\Temp\opencode\ar-ref</ReferenceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AssetRipper.SourceGenerated">
      <HintPath>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release\AssetRipper.SourceGenerated.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.SourceGenerated.Extensions">
      <HintPath>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release\AssetRipper.SourceGenerated.Extensions.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.Assets">
      <HintPath>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release\AssetRipper.Assets.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.Processing">
      <HintPath>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release\AssetRipper.Processing.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.Checksum">
      <HintPath>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release\AssetRipper.Checksum.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.Import">
      <HintPath>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release\AssetRipper.Import.dll</HintPath>
    </Reference>
    <Reference Include="AssetRipper.IO.Endian">
      <HintPath>$(ReferenceRoot)\Source\0Bins\AssetRipper.GUI.Free\Release\AssetRipper.IO.Endian.dll</HintPath>
